{
  "name": "aureon",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Aureon — a liquid-glass, space-themed personal tracker (todos, tasks, deadlines, reminders, finances) built with Vue 3 + Firebase.",
  "scripts": {
    "dev": "vite",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "type-check": "vue-tsc --noEmit",
    "verify": "npm run format:check && npm run type-check && npm run test",
    "build": "npm run verify && vite build",
    "build:only": "vue-tsc -b && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "firebase": "^12.8.0",
    "pinia": "^3.0.1",
    "vue": "^3.5.13",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.1",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.5",
    "typescript": "~5.7.3",
    "vite": "^6.0.11",
    "vite-plugin-vue-devtools": "^8.1.5",
    "vitest": "^3.2.7",
    "vue-tsc": "^2.2.0"
  }
}
