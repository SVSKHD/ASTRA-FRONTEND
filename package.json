{
  "name": "aureon",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Aureon — a liquid-glass, space-themed personal tracker (todos, tasks, deadlines, reminders, finances) built with Vue 3 + Firebase.",
  "scripts": {
    "dev": "vite",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "type-check": "vue-tsc -b --force",
    "verify": "npm run format:check && npm run type-check && npm run test",
    "build": "npm run verify && vite build",
    "build:only": "vue-tsc -b && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@fullcalendar/core": "^6.1.21",
    "@fullcalendar/daygrid": "^6.1.21",
    "@fullcalendar/interaction": "^6.1.21",
    "@fullcalendar/list": "^6.1.21",
    "@fullcalendar/timegrid": "^6.1.21",
    "@fullcalendar/vue3": "^6.1.21",
    "@joint/core": "^4.3.1",
    "firebase": "^12.8.0",
    "leaflet": "^1.9.4",
    "pinia": "^3.0.1",
    "qrcode": "^1.5.4",
    "viem": "^2.55.16",
    "vue": "^3.5.13",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.21",
    "@types/qrcode": "^1.5.6",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/test-utils": "^2.4.11",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.5",
    "rollup-plugin-visualizer": "^7.1.1",
    "typescript": "~5.7.3",
    "vite": "^6.0.11",
    "vite-plugin-pwa": "^1.3.0",
    "vite-plugin-vue-devtools": "^8.1.5",
    "vitest": "^3.2.7",
    "vue-tsc": "^2.2.0"
  }
}
