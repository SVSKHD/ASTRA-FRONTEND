# Sign-in AND data — Supabase Auth plus Postgres. Create a Supabase project, run
# the SQL migrations under supabase/migrations, create the owner account with an
# email + passcode (docs/SUPABASE_NORMALISATION_PLAN.md, "Phase 3"), then copy these
# public browser values from Project Settings. The /api/github function reads
# the same two values to verify sessions.
# Never put a service-role key in VITE_* variables.
VITE_SUPABASE_URL=https://jixmbcrfretemshhnqlm.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_Wx3N0Kq7xNFLg_ClUnki_g_z3bZGr6U
# Legacy projects may still call this the anon key. Leave blank when using the
# publishable key above.
VITE_SUPABASE_ANON_KEY=
# Phase 2 (docs/SUPABASE_NORMALISATION_PLAN.md): domains served from real
# tables instead of the JSONB compatibility table, comma-separated. Set a domain
# only AFTER its migration has been applied in the Supabase SQL editor:
#   trading → supabase/migrations/20260923_normalise_trading.sql
VITE_SUPABASE_TABLES=trading

# Firebase is no longer used for sign-in. These remain only for the pieces not
# yet moved to Supabase — Cloud Functions and Storage attachments — which are
# unavailable while sign-in is Supabase (they accept Firebase sign-in only).
# Optional: the app runs without them.
VITE_FIREBASE_API_KEY=REPLACE_WITH_FIREBASE_WEB_API_KEY
VITE_FIREBASE_AUTH_DOMAIN=REPLACE_WITH_FIREBASE_AUTH_DOMAIN
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=REPLACE_WITH_FIREBASE_PROJECT_ID
VITE_FIREBASE_STORAGE_BUCKET=REPLACE_WITH_FIREBASE_STORAGE_BUCKET
VITE_FIREBASE_MESSAGING_SENDER_ID=REPLACE_WITH_FIREBASE_MESSAGING_SENDER_ID
VITE_FIREBASE_APP_ID=1:616298926621:web:fb000c48b4f7dac325ecf4
VITE_FIREBASE_MEASUREMENT_ID=

# Owner access. Either or both lists may contain comma-separated values.
# UIDS are Supabase user ids (Authentication → Users), not Firebase uids.
VITE_ALLOWED_UIDS=4f8e63a6-4021-4de3-bf6c-7dfee7b9d22d
VITE_ALLOWED_EMAILS=8svskhd@gmail.com
VITE_AUTO_LOCK_MINUTES=50

# GitHub integration (section 13). The proxy (/api/github, a Netlify function)
# holds the GitHub token server-side; the browser only ever sends its Supabase
# session token, which the function verifies. Leave blank to disable.
VITE_GH_PROXY_URL=/api/github
VITE_GH_APP_SLUG=

# Optional: Cloud Function that returns a public address's balance. Leave blank
# to disable the per-wallet balance opt-in. No chain API key belongs in the client.
VITE_WALLET_BALANCE_URL=

# The demo account (section 38). Keep its password in .env.local only.
VITE_DEMO_UID=
VITE_DEMO_EMAIL=demo@example.com
# VITE_DEMO_PASSWORD=  <-- .env.local only. Never commit, never inline, never log.

# Dev-only screenshot/fixture switches.
VITE_AUTO_LOGIN=
VITE_FIXTURE=
