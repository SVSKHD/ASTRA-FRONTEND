# Primary data store — create a Supabase project, run the SQL migration under
# supabase/migrations, then copy these public browser values from Project Settings.
# Never put a service-role key in VITE_* variables.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Legacy projects may still call this the anon key. Leave blank when using the
# publishable key above.
VITE_SUPABASE_ANON_KEY=

# Firebase remains the identity provider during the database migration. Google /
# GitHub sign-in, Cloud Functions, Storage attachments and the function-written
# news/GitHub/security mirrors still use this app for now.
VITE_FIREBASE_API_KEY=REPLACE_WITH_FIREBASE_WEB_API_KEY
VITE_FIREBASE_AUTH_DOMAIN=REPLACE_WITH_FIREBASE_AUTH_DOMAIN
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=REPLACE_WITH_FIREBASE_PROJECT_ID
VITE_FIREBASE_STORAGE_BUCKET=REPLACE_WITH_FIREBASE_STORAGE_BUCKET
VITE_FIREBASE_MESSAGING_SENDER_ID=REPLACE_WITH_FIREBASE_MESSAGING_SENDER_ID
VITE_FIREBASE_APP_ID=REPLACE_WITH_FIREBASE_APP_ID
VITE_FIREBASE_MEASUREMENT_ID=

# Owner access. Either or both lists may contain comma-separated values.
VITE_ALLOWED_UIDS=REPLACE_WITH_FIREBASE_AUTH_UID
VITE_ALLOWED_EMAILS=REPLACE_WITH_ALLOWED_EMAIL
VITE_AUTO_LOCK_MINUTES=50

# GitHub integration (section 13). The ghProxy Cloud Function exchanges and
# refreshes the GitHub App installation token server-side; the browser only ever
# sends its Firebase ID token. Leave blank to disable the integration.
VITE_GH_PROXY_URL=
VITE_GH_APP_SLUG=

# Optional: Cloud Function that returns a public address's balance. Leave blank
# to disable the per-wallet balance opt-in. No chain API key belongs in the client.
VITE_WALLET_BALANCE_URL=

# The demo account (section 38). Keep its password in .env.local only.
VITE_DEMO_UID=
VITE_DEMO_EMAIL=demo@example.com
# VITE_DEMO_PASSWORD=  <-- .env.local only. Never commit, never inline, never log.

# Dev-only screenshot/fixture switches.
VITE_AUTO_LOGIN=
VITE_FIXTURE=
