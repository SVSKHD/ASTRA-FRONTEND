# Firebase web config — copy to `.env.local` and fill from your Firebase project
# (Project settings → General → Your apps → Web app → SDK setup and configuration).
#
# Firebase is required. Replace every placeholder before starting the app.
VITE_FIREBASE_API_KEY=AIzaSyAvTW0LWeAtzvaC_fAEJmd7akXmIc8Wwrw
VITE_FIREBASE_AUTH_DOMAIN=spasta-personal-finance.firebaseapp.com
VITE_FIREBASE_DATABASE_URL=https://spasta-personal-finance-default-rtdb.firebaseio.com
VITE_FIREBASE_PROJECT_ID=spasta-personal-finance
VITE_FIREBASE_STORAGE_BUCKET=spasta-personal-finance.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=616298926621
VITE_FIREBASE_APP_ID=1:616298926621:web:fb000c48b4f7dac325ecf4
VITE_FIREBASE_MEASUREMENT_ID=G-0MBNYMETF9

# Owner access. Either or both lists may contain comma-separated values.
VITE_ALLOWED_UIDS=REPLACE_WITH_FIREBASE_AUTH_UID
VITE_ALLOWED_EMAILS=8svskhd@gmail.com
VITE_AUTO_LOCK_MINUTES=50

# GitHub integration (section 13). The ghProxy Cloud Function exchanges and
# refreshes the GitHub App installation token server-side; the browser only ever
# sends its Firebase ID token. Leave blank to disable the integration.
VITE_GH_PROXY_URL=
VITE_GH_APP_SLUG=

# Optional: Cloud Function that returns a public address's balance. Leave blank
# to disable the per-wallet balance opt-in. No chain API key belongs in the client.
VITE_WALLET_BALANCE_URL=
