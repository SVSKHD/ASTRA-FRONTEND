# Firebase web config — copy to `.env.local` and fill from your Firebase project
# (Project settings → General → Your apps → Web app → SDK setup and configuration).
#
# All values are optional: if they are missing, Aureon runs in "local only" mode
# (no cloud sync, and the Google/GitHub sign-in buttons fall back to a demo profile).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
