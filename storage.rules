rules_version = '2';

// Receipt attachments (section 27b).
//
// The path is `users/{uid}/finance/{txnId}/{file}` and the uid is the FIRST
// segment for exactly this reason: ownership is then a path match rather than a
// metadata lookup, so the rule is one comparison and cannot be defeated by a
// file whose metadata was written before the rule existed.
//
// `utils/attachments.ts` sanitises the filename before upload — a name
// containing a slash would otherwise climb out of this prefix — but the limits
// below are enforced here as well. A client-side check is a courtesy to the
// user; this is the one that holds when the client is not ours.
service firebase.storage {
  match /b/{bucket}/o {
    match /users/{userId}/finance/{txnId}/{fileName} {
      allow read: if request.auth != null && request.auth.uid == userId;

      allow write: if request.auth != null
        && request.auth.uid == userId
        && request.resource.size <= 8 * 1024 * 1024
        && (
          request.resource.contentType.matches('image/.*')
          || request.resource.contentType == 'application/pdf'
        );

      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // Everything else is denied. A bucket with a permissive default is a
    // public file host with extra steps.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
