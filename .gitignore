# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules
/.pnp
.pnp.*

# build output
dist
# the functions' compiled output. `firebase deploy` builds it from `functions/src`
# through the predeploy hook, so a committed copy is only ever a stale one that
# looks authoritative.
functions/lib
# harness output — the shots that matter go on the pull request
screenshots
dist-ssr
dev-dist
/build
/coverage

# local env files (never commit real Firebase keys)
.env
.env.*
!.env.example

# editor / os
.DS_Store
*.pem
.vscode/*
!.vscode/extensions.json
.idea

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
logs
*.log

# typescript build info
*.tsbuildinfo

# vercel / netlify
.vercel
.netlify
