rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    // Aureon: one complete workspace document per authenticated Firebase user.
    // Google OR GitHub authentication is sufficient because both provide auth.uid.
    match /aureon-notes/{userId} {
      allow read, create, update, delete: if isSignedIn()
        && request.auth.uid == userId;
    }

    match /Astra-users/{userId} {
      allow read, write: if isSignedIn()
        && request.auth.uid == userId;
    }

    match /forex/{docId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn()
        && request.auth.token.admin == true;
    }

    match /astra_notes/{noteId} {
      allow read: if resource.data.isShared == true
        || (isSignedIn() && resource.data.userId == request.auth.uid);

      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid;

      allow update: if isSignedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == request.auth.uid;

      allow delete: if isSignedIn()
        && resource.data.userId == request.auth.uid;
    }

    match /{collection}/{document} {
      function hasGenericUserIdField() {
        return resource.data.keys().hasAny(['userId']);
      }

      allow create: if isSignedIn()
        && (
          !('userId' in request.resource.data)
          || request.resource.data.userId == request.auth.uid
        );

      allow read: if isSignedIn()
        && (
          (hasGenericUserIdField() && resource.data.userId == request.auth.uid)
          || !hasGenericUserIdField()
        );

      allow update: if isSignedIn()
        && hasGenericUserIdField()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == request.auth.uid;

      allow delete: if isSignedIn()
        && hasGenericUserIdField()
        && resource.data.userId == request.auth.uid;
    }
  }
}
