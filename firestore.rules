rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Aureon is a single-user personal workspace: every document is owned by
    // exactly one auth uid, either via the document path or an owner field.
    // There is no shared/team data, so the default posture is deny.

    function isSignedIn() {
      return request.auth != null;
    }

    // Owner uid on an existing doc, from whichever field the writer used.
    // Aureon's workspace doc uses `ownerId`; the Astra collections use `userId`.
    function ownerOf(data) {
      return data.keys().hasAny(['userId']) ? data.userId
           : data.keys().hasAny(['ownerId']) ? data.ownerId
           : null;
    }

    function ownsExisting() {
      return isSignedIn() && ownerOf(resource.data) == request.auth.uid;
    }

    function ownsIncoming() {
      return isSignedIn() && ownerOf(request.resource.data) == request.auth.uid;
    }

    // AUREON: one complete workspace document per uid, keyed by the uid itself.
    // No hardcoded email and no sign_in_provider gate — a hardcoded owner email
    // here previously locked every other account out of its own workspace.
    // This one document also carries the user's wallet address book (section
    // 14): public receive addresses only, never a key or seed. They live here —
    // under the user, never under a project — precisely so this rule is the only
    // gate they need: another signed-in user's uid does not match {userId}, so
    // their read is denied (acceptance 65).
    match /aureon-notes/{userId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }

    match /Astra-users/{userId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }

    // THE GITHUB TOKEN (section 44, item 9).
    //
    // Denied to EVERY client, including the account it belongs to. That is not
    // an oversight and it is not conservatism: the guided setup's whole promise
    // is that the token is posted once and never comes back, and a rule that
    // let the owner read their own document would make that promise false — a
    // compromised session could read the token straight out of Firestore and
    // the app would have handed it over.
    //
    // The Admin SDK bypasses rules entirely, so the functions that need it
    // (`tokenFor`, the sweep) are unaffected. Nothing else can see it at all.
    //
    // The document also carries the login, the connection time and the last
    // sync, which are not secret — but they live here rather than in
    // `Astra-users` so that this rule can be `false` with no exceptions to
    // reason about. The app reads them through `githubStatus`, which returns
    // the facts and not the field.
    match /gh-secrets/{userId} {
      allow read, write: if false;
    }

    // DEVICES + ACTIVITY (section 27a).
    //
    // Read-only to the client, in both collections. Every field that matters —
    // the IP hash, the coarse location, `lastActiveAt`, `revokedAt` — is either
    // a secret derivation or a security control, and a client that could write
    // them could forge a device row, backdate its own liveness, or un-revoke
    // itself after being signed out. So all writes go through the callable
    // functions, which run as admin and bypass these rules entirely.
    //
    // Note this is a genuine subtree under /users/{uid}, unlike the rest of the
    // workspace: a single document cannot express "this row is revoked and may
    // no longer be read", and that sentence is the whole feature.
    match /users/{userId}/sessions/{sessionId} {
      // `revokedAt == null` is the rule half of revocation, and it applies to
      // single-document reads and to collection queries alike (Firestore
      // evaluates a query against every document it would return, so a revoked
      // row does not merely disappear from the list — it fails the read).
      //
      // The consequence is deliberate: a revoked device cannot even see its own
      // session row. That is the signal the client watches for. The full chain
      // is three links, because no one of them is sufficient:
      //
      //   1. this rule stops the revoked device reading;
      //   2. `heartbeat` returns { revoked: true } and the client signs itself
      //      out, which handles the tab that is already open and would
      //      otherwise keep rendering what it has in memory;
      //   3. `revokeRefreshTokens` in the admin SDK stops it minting a fresh
      //      ID token, which is the only link that holds against a device whose
      //      user has disabled JavaScript's cooperation entirely.
      //
      // Revoked rows are therefore absent from the devices list rather than
      // shown greyed out. The revocation is still visible — it is an entry in
      // the activity log, which is where a past event belongs.
      allow read: if isSignedIn()
        && request.auth.uid == userId
        && resource.data.get('revokedAt', null) == null;
      allow write: if false;
    }

    match /users/{userId}/activity/{eventId} {
      allow read: if isSignedIn() && request.auth.uid == userId;
      allow write: if false;
    }

    // TRADE LOGGER (section 28).
    //
    // Three real subcollections under the uid, unlike the rest of the
    // workspace: a trading month is hundreds of rows written one at a time and
    // read back by date range, which is a query rather than a field on a blob.
    //
    // The path IS the ownership check — another signed-in user's uid does not
    // match {userId}, so their read is denied before any field is looked at —
    // and, unlike the device rows above, the client is the writer here: these
    // are the user's own records, not security controls, so there is no
    // callable to route them through.
    //
    // `{document=**}` on each so a future sub-document (an attachment on a
    // trade, say) inherits the same gate rather than falling through to the
    // catch-all at the bottom, which only matches top-level collections.
    match /users/{userId}/trades/{tradeId}/{document=**} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }

    match /users/{userId}/secured/{securedId}/{document=**} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }

    match /users/{userId}/settings/{settingId}/{document=**} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }

    match /users/{userId} {
      allow read: if isSignedIn() && request.auth.uid == userId;
      allow write: if false;
    }

    // AUREON SHARES: one frozen snapshot per shared item.
    // The workspace is a single document, so a rule cannot expose one todo out
    // of an array — each share gets its own document and is gated here.
    // A public share is readable by anyone, signed in or not; a private share
    // is readable only by the uid that created it.
    match /aureon-shares/{shareId} {
      allow read: if resource.data.isPublic == true
        || (isSignedIn() && resource.data.ownerId == request.auth.uid);
      allow create: if isSignedIn()
        && request.resource.data.ownerId == request.auth.uid;
      // Ownership is immutable: a share cannot be reassigned to another uid.
      allow update: if isSignedIn()
        && resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerId == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.ownerId == request.auth.uid;
    }

    // Forex: any signed-in user can READ; only admins can WRITE.
    match /forex/{docId} {
      allow read:  if isSignedIn();
      allow write: if isSignedIn() && request.auth.token.get('admin', false) == true;
    }

    // `.get()` rather than a bare field read: the field is absent on most
    // documents, and a bare read of a missing field errors out the rule.
    function isPubliclyShared() {
      return resource.data.get('isShared', false) == true;
    }

    // NOTES: public read when explicitly shared, otherwise owner-only.
    match /astra_notes/{noteId} {
      allow read: if isPubliclyShared() || ownsExisting();
      allow create: if ownsIncoming();
      allow update, delete: if ownsExisting() && ownsIncoming();
    }

    // Trading journal: owner-only, except a bot flagged for public sharing.
    // The share page resolves by slug for signed-out visitors, so the read
    // rule must not require auth on shared docs.
    match /astra-trading-journal/{botId} {
      allow read: if isPubliclyShared() || ownsExisting();
      allow create: if ownsIncoming();
      allow update: if ownsExisting() && ownsIncoming();
      allow delete: if ownsExisting();
    }

    // Everything else: owner-only, and an owner field is REQUIRED.
    // Documents without one are unreachable by design — that is what keeps a
    // signed-in stranger from reading another uid's data through this branch.
    // Update requires ownership both before and after, so the owner field
    // cannot be reassigned to someone else.
    match /{collection}/{document} {
      allow create: if ownsIncoming();
      allow read, delete: if ownsExisting();
      allow update: if ownsExisting() && ownsIncoming();
    }
  }
}
